<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened-runtime entitlements for the notarized, non-sandboxed build.
         Core Audio process taps and the microphone need no entitlement beyond
         audio-input; access is governed by TCC (System Audio Recording,
         Microphone, Accessibility) at runtime. -->

    <!-- Must be false for a distributable build -->
    <key>com.apple.security.get-task-allow</key>
    <false/>

    <!-- Microphone (hardened-runtime resource access) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Calendar events (hardened-runtime resource access; TCC still asks) -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>

    <!-- NOTE: if the App Sandbox is ever enabled, add
         com.apple.security.app-sandbox = true and
         com.apple.security.network.client = true (Whisper uploads). -->
</dict>
</plist>
